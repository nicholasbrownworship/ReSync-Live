# Copy relevant values into your actual environment before running
# app.py. None of this is required to run with zero TURN/password
# config, but connections outside your own network need the TURN
# values filled in once coturn is set up (see docs/ARCHITECTURE.md).

RESYNC_LIVE_TURN_HOST=
RESYNC_LIVE_TURN_PORT=3478
RESYNC_LIVE_TURN_USERNAME=
RESYNC_LIVE_TURN_CREDENTIAL=

# Can also just be set live in the desktop app's password field instead.
RESYNC_LIVE_SESSION_PASSWORD=
